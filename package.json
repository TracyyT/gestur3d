{
  "name": "gestur3d",
  "private": true,
  "description": "Gesture-controlled holographic 3D workspace with custom-trained gesture models",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gestur3d/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @gestur3d/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @gestur3d/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
